{
  "expo": {
    "name": "Qibla & Namaz",
    "slug": "qibla-namaz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qiblanamaz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "googleMapsApiKey": "AIzaSyBdU99je_Fd3jl8rn0UYTvgHVuX58nQl-M",
      "admob": {
        "android": {
          "appOpen": "",
          "interstitial": "",
          "rewardedAudio": "",
          "rewardedInterstitial": "",
          "bannerHomeBottom": "",
          "bannerAboutTop": "",
          "bannerBottomDock": ""
        },
        "ios": {
          "appOpen": "",
          "interstitial": "",
          "rewardedAudio": "",
          "rewardedInterstitial": "",
          "bannerHomeBottom": "",
          "bannerAboutTop": "",
          "bannerBottomDock": ""
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.qiblanamaz",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to show nearby map area, calculate Qibla direction, and compute prayer times."
      }
    },
    "android": {
      "package": "com.anonymous.qiblanamaz",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBdU99je_Fd3jl8rn0UYTvgHVuX58nQl-M"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "optimizeInitialization": true,
          "optimizeAdLoading": true,
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
