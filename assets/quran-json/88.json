{
  "number": 88,
  "name": "سورَة ٱلْغَاشِيَة",
  "nameTrans": "Surah Al-Ghaashiyah",
  "nameMl": "അല്‍ ഗാശിയഃ",
  "totalVerses": 26,
  "verses": [
    {
      "number": 1,
      "arabic": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ",
      "malayalam": "(നബിയേ,) ആ മൂടുന്ന സംഭവത്തെ സംബന്ധിച്ച വര്‍ത്തമാനം നിനക്ക് വന്നുകിട്ടിയോ"
    },
    {
      "number": 2,
      "arabic": "وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ",
      "malayalam": "അന്നേ ദിവസം ചില മുഖങ്ങള്‍ താഴ്മകാണിക്കുന്നതും"
    },
    {
      "number": 3,
      "arabic": "عَامِلَةࣱ نَّاصِبَةࣱ‏",
      "malayalam": "പണിയെടുത്ത് ക്ഷീണിച്ചതുമായിരിക്കും"
    },
    {
      "number": 4,
      "arabic": "تَصۡلَىٰ نَارًا حَامِيَةࣰ‏",
      "malayalam": "ചൂടേറിയ അഗ്നിയില്‍ അവ പ്രവേശിക്കുന്നതാണ്‌"
    },
    {
      "number": 5,
      "arabic": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ‏",
      "malayalam": "ചുട്ടുതിളക്കുന്ന ഒരു ഉറവില്‍ നിന്ന് അവര്‍ക്കു കുടിപ്പിക്കപ്പെടുന്നതാണ്‌"
    },
    {
      "number": 6,
      "arabic": "لَّيۡسَ لَهُمُۥ طَعَامٌ إِلَّا مِن ضَرِيعࣲ‏",
      "malayalam": "ളരീഇല്‍ നിന്നല്ലാതെ അവര്‍ക്ക് യാതൊരു ആഹാരവുമില്ല"
    },
    {
      "number": 7,
      "arabic": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ‏",
      "malayalam": "അത് പോഷണം നല്‍കുകയില്ല. വിശപ്പിന് ശമനമുണ്ടാക്കുകയുമില്ല"
    },
    {
      "number": 8,
      "arabic": "وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ‏",
      "malayalam": "ചില മുഖങ്ങള്‍ അന്നു തുടുത്തു മിനുത്തതായിരിക്കും"
    },
    {
      "number": 9,
      "arabic": "لِّسَعۡيِهَا رَاضِيَةࣱ‏",
      "malayalam": "അവയുടെ പ്രയത്നത്തെപ്പറ്റി തൃപ്തിയടഞ്ഞവയുമായിരിക്കും"
    },
    {
      "number": 10,
      "arabic": "فِي جَنَّةٍ عَالِيَةࣲ‏",
      "malayalam": "ഉന്നതമായ സ്വര്‍ഗത്തില്‍"
    },
    {
      "number": 11,
      "arabic": "لَّا يُسۡمَعُ فِيهَا لَٰغِيَةࣱ‏",
      "malayalam": "അവിടെ യാതൊരു നിരര്‍ത്ഥകമായ വാക്കും അവര്‍ കേള്‍ക്കുകയില്ല"
    },
    {
      "number": 12,
      "arabic": "فِيهَا عَيۡنࣱ جَارِيَةࣱ‏",
      "malayalam": "അതില്‍ ഒഴുകി കൊണ്ടിരിക്കുന്ന അരുവിയുണ്ട്‌"
    },
    {
      "number": 13,
      "arabic": "فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ‏",
      "malayalam": "അതില്‍ ഉയര്‍ത്തിവെക്കപ്പെട്ട കട്ടിലുകളും"
    },
    {
      "number": 14,
      "arabic": "وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ‏",
      "malayalam": "തയ്യാറാക്കി വെക്കപ്പെട്ട കോപ്പകളും"
    },
    {
      "number": 15,
      "arabic": "وَنَمَارِقُ مَصۡفُوفَةࣱ‏",
      "malayalam": "അണിയായി വെക്കപ്പെട്ട തലയണകളും"
    },
    {
      "number": 16,
      "arabic": "وَزَرَابِيُّ مَبۡثُوثَةٌ",
      "malayalam": "വിരിച്ചുവെക്കപ്പെട്ട പരവതാനികളുമുണ്ട്‌"
    },
    {
      "number": 17,
      "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ",
      "malayalam": "ഒട്ടകത്തിന്‍റെ നേര്‍ക്ക് അവര്‍ നോക്കുന്നില്ലേ? അത് എങ്ങനെ സൃഷ്ടിക്കപ്പെട്ടിരിക്കുന്നു എന്ന്‌"
    },
    {
      "number": 18,
      "arabic": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ",
      "malayalam": "ആകാശത്തേക്ക് (അവര്‍ നോക്കുന്നില്ലേ?) അത് എങ്ങനെ ഉയര്‍ത്തപ്പെട്ടിരിക്കുന്നു എന്ന്‌"
    },
    {
      "number": 19,
      "arabic": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ",
      "malayalam": "പര്‍വ്വതങ്ങളിലേക്ക് (അവര്‍ നോക്കുന്നില്ലേ?) അവ എങ്ങനെ നാട്ടിനിര്‍ത്തപ്പെട്ടിരിക്കുന്നു വെന്ന്‌"
    },
    {
      "number": 20,
      "arabic": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ",
      "malayalam": "ഭൂമിയിലേക്ക് (അവര്‍ നോക്കുന്നില്ലേ?) അത് എങ്ങനെ പരത്തപ്പെട്ടിരിക്കുന്നുവെന്ന്‌"
    },
    {
      "number": 21,
      "arabic": "فَذَكِّرۡ إِنَّمَا أَنتَ مُذَكِّرࣱ‏",
      "malayalam": "അതിനാല്‍ (നബിയേ,) നീ ഉല്‍ബോധിപ്പിക്കുക. നീ ഒരു ഉല്‍ബോധകന്‍ മാത്രമാകുന്നു"
    },
    {
      "number": 22,
      "arabic": "لَّسۡتَ عَلَيۡهِمُۥ بِمُصَيۡطِرٍ",
      "malayalam": "നീ അവരുടെ മേല്‍ അധികാരം ചെലുത്തേണ്ടവനല്ല"
    },
    {
      "number": 23,
      "arabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "malayalam": "പക്ഷെ, വല്ലവനും തിരിഞ്ഞുകളയുകയും, അവിശ്വസിക്കുകയും ചെയ്യുന്ന പക്ഷം"
    },
    {
      "number": 24,
      "arabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
      "malayalam": "അല്ലാഹു അവനെ ഏറ്റവും വലിയ ശിക്ഷ ശിക്ഷിക്കുന്നതാണ്‌"
    },
    {
      "number": 25,
      "arabic": "إِنَّ إِلَيۡنَا إِيَابَهُمُۥ",
      "malayalam": "തീര്‍ച്ചയായും നമ്മുടെ അടുത്തേക്കാണ് അവരുടെ മടക്കം"
    },
    {
      "number": 26,
      "arabic": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُمُۥ",
      "malayalam": "പിന്നീട്‌, തീര്‍ച്ചയായും നമ്മുടെ ബാധ്യതയാണ് അവരുടെ വിചാരണ"
    }
  ]
}