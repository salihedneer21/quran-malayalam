{
  "number": 82,
  "name": "سورَة ٱلْإِنْفِطَار",
  "nameTrans": "Surah Al-Infitar",
  "nameMl": "അല്‍ ഇന്‍ഫിത്വാര്‍",
  "totalVerses": 19,
  "verses": [
    {
      "number": 1,
      "arabic": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ",
      "malayalam": "ആകാശം പൊട്ടി പിളരുമ്പോള്‍"
    },
    {
      "number": 2,
      "arabic": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",
      "malayalam": "നക്ഷത്രങ്ങള്‍ കൊഴിഞ്ഞു വീഴുമ്പോള്‍"
    },
    {
      "number": 3,
      "arabic": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ",
      "malayalam": "സമുദ്രങ്ങള്‍ പൊട്ടി ഒഴുകുമ്പോള്‍"
    },
    {
      "number": 4,
      "arabic": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",
      "malayalam": "ഖബ്‌റുകള്‍ ഇളക്കിമറിക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 5,
      "arabic": "عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ",
      "malayalam": "ഓരോ വ്യക്തിയും താന്‍ മുന്‍കൂട്ടി ചെയ്തു വെച്ചതും പിന്നോട്ട് മേറ്റീവ്ച്ചതും എന്താണെന്ന് അറിയുന്നതാണ്‌"
    },
    {
      "number": 6,
      "arabic": "يَٰأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ",
      "malayalam": "ഹേ; മനുഷ്യാ, ഉദാരനായ നിന്‍റെ രക്ഷിതാവിന്‍റെ കാര്യത്തില്‍ നിന്നെ വഞ്ചിച്ചു കളഞ്ഞതെന്താണ്‌"
    },
    {
      "number": 7,
      "arabic": "ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ",
      "malayalam": "നിന്നെ സൃഷ്ടിക്കുകയും, നിന്നെ സംവിധാനിക്കുകയും , നിന്നെ ശരിയായ അവസ്ഥയിലാക്കുകയും ചെയ്തവനത്രെ അവന്‍"
    },
    {
      "number": 8,
      "arabic": "فِي أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ",
      "malayalam": "താന്‍ ഉദ്ദേശിച്ച രൂപത്തില്‍ നിന്നെ സംഘടിപ്പിച്ചവന്‍"
    },
    {
      "number": 9,
      "arabic": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ",
      "malayalam": "അല്ല; പക്ഷെ, പ്രതിഫല നടപടിയെ നിങ്ങള്‍ നിഷേധിച്ചു തള്ളുന്നു"
    },
    {
      "number": 10,
      "arabic": "وَإِنَّ عَلَيۡكُمُۥ لَحَٰفِظِينَ",
      "malayalam": "തീര്‍ച്ചയായും നിങ്ങളുടെ മേല്‍ ചില മേല്‍നോട്ടക്കാരുണ്ട്‌"
    },
    {
      "number": 11,
      "arabic": "كِرَامࣰ ا كَٰتِبِينَ",
      "malayalam": "രേഖപ്പെടുത്തിവെക്കുന്ന ചില മാന്യന്‍മാര്‍"
    },
    {
      "number": 12,
      "arabic": "يَعۡلَمُونَ مَا تَفۡعَلُونَ",
      "malayalam": "നിങ്ങള്‍ പ്രവര്‍ത്തിക്കുന്നത് അവര്‍ അറിയുന്നു"
    },
    {
      "number": 13,
      "arabic": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ‏",
      "malayalam": "തീര്‍ച്ചയായും സുകൃതവാന്‍മാര്‍ സുഖാനുഭവത്തില്‍ തന്നെയായിരിക്കും"
    },
    {
      "number": 14,
      "arabic": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمࣲ‏",
      "malayalam": "തീര്‍ച്ചയായും ദുര്‍മാര്‍ഗികള്‍ ജ്വലിക്കുന്ന നരകാഗ്നിയില്‍ തന്നെയായിരിക്കും"
    },
    {
      "number": 15,
      "arabic": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ",
      "malayalam": "പ്രതിഫലത്തിന്‍റെ നാളില്‍ അവരതില്‍ കടന്ന് എരിയുന്നതാണ്‌"
    },
    {
      "number": 16,
      "arabic": "وَمَا هُمُۥ عَنۡهَا بِغَآئِبِينَ",
      "malayalam": "അവര്‍ക്ക് അതില്‍ നിന്ന് മാറി നില്‍ക്കാനാവില്ല"
    },
    {
      "number": 17,
      "arabic": "وَمَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
      "malayalam": "പ്രതിഫലനടപടിയുടെ ദിവസം എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ"
    },
    {
      "number": 18,
      "arabic": "ثُمَّ مَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
      "malayalam": "വീണ്ടും; പ്രതിഫലനടപടിയുടെ ദിവസം എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ"
    },
    {
      "number": 19,
      "arabic": "يَوۡمُ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔ اۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ",
      "malayalam": "ഒരാള്‍ക്കും മറ്റൊരാള്‍ക്കു വേണ്ടി യാതൊന്നും അധീനപ്പെടുത്താനാവാത്ത ഒരു ദിവസം. അന്നേ ദിവസം കൈകാര്യകര്‍ത്തൃത്വം അല്ലാഹുവിന്നായിരിക്കും"
    }
  ]
}