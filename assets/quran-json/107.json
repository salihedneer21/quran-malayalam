{
  "number": 107,
  "name": "سورَة ٱلْمَاعُون",
  "nameTrans": "Surah Al-Maa'oon",
  "nameMl": "അല്‍ മാഊന്‍",
  "totalVerses": 7,
  "verses": [
    {
      "number": 1,
      "arabic": "أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ",
      "malayalam": "മതത്തെ വ്യാജമാക്കുന്നവന്‍ ആരെന്ന് നീ കണ്ടുവോ"
    },
    {
      "number": 2,
      "arabic": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ",
      "malayalam": "അനാഥക്കുട്ടിയെ തള്ളിക്കളയുന്നവനത്രെ അത്‌"
    },
    {
      "number": 3,
      "arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
      "malayalam": "പാവപ്പെട്ടവന്‍റെ ഭക്ഷണത്തിന്‍റെ കാര്യത്തില്‍ പ്രോത്സാഹനം നടത്താതിരിക്കുകയും ചെയ്യുന്നവന്‍"
    },
    {
      "number": 4,
      "arabic": "فَوَيۡلࣱ لِّلۡمُصَلِّينَ",
      "malayalam": "എന്നാല്‍ നമസ്കാരക്കാര്‍ക്കാകുന്നു നാശം"
    },
    {
      "number": 5,
      "arabic": "ٱلَّذِينَ هُمُۥ عَن صَلَاتِهِمُۥ سَاهُونَ",
      "malayalam": "തങ്ങളുടെ നമസ്കാരത്തെപ്പറ്റി ശ്രദ്ധയില്ലാത്തവരായ"
    },
    {
      "number": 6,
      "arabic": "ٱلَّذِينَ هُمُۥ يُرَآءُونَ",
      "malayalam": "ജനങ്ങളെ കാണിക്കാന്‍ വേണ്ടി പ്രവര്‍ത്തിക്കുന്നവരായ"
    },
    {
      "number": 7,
      "arabic": "وَيَمۡنَعُونَ ٱلۡمَاعُونَ",
      "malayalam": "പരോപകാര വസ്തുക്കള്‍ മുടക്കുന്നവരുമായ"
    }
  ]
