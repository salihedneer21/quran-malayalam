{
  "number": 81,
  "name": "سورَة ٱلتَّكْوِير",
  "nameTrans": "Surah At-Takweer",
  "nameMl": "അത്തക് വീര്‍",
  "totalVerses": 29,
  "verses": [
    {
      "number": 1,
      "arabic": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",
      "malayalam": "സൂര്യന്‍ ചുറ്റിപ്പൊതിയപ്പെടുമ്പോള്‍"
    },
    {
      "number": 2,
      "arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",
      "malayalam": "നക്ഷത്രങ്ങള്‍ ഉതിര്‍ന്നു വീഴുമ്പോള്‍"
    },
    {
      "number": 3,
      "arabic": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ",
      "malayalam": "പര്‍വ്വതങ്ങള്‍ സഞ്ചരിപ്പിക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 4,
      "arabic": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",
      "malayalam": "പൂര്‍ണ്ണഗര്‍ഭിണികളായ ഒട്ടകങ്ങള്‍ അവഗണിക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 5,
      "arabic": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",
      "malayalam": "വന്യമൃഗങ്ങള്‍ ഒരുമിച്ചുകൂട്ടപ്പെടുമ്പോള്‍"
    },
    {
      "number": 6,
      "arabic": "وَإِذَا ٱلۡبِحَارُ سُجِرَتۡ",
      "malayalam": "സമുദ്രങ്ങള്‍ ആളിക്കത്തിക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 7,
      "arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",
      "malayalam": "ആത്മാവുകള്‍ കൂട്ടിയിണക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 8,
      "arabic": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ",
      "malayalam": "(ജീവനോടെ) കുഴിച്ചു മൂടപ്പെട്ട പെണ്‍കുട്ടിയോടു ചോദിക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 9,
      "arabic": "بِأَيِّ ذَنۢبࣲ قُتِلَتۡ",
      "malayalam": "താന്‍ എന്തൊരു കുറ്റത്തിനാണ് കൊല്ലപ്പെട്ടത് എന്ന്‌"
    },
    {
      "number": 10,
      "arabic": "وَإِذَا ٱلصُّحُفُ نُشِّرَتۡ",
      "malayalam": "(കര്‍മ്മങ്ങള്‍ രേഖപ്പെടുത്തിയ) ഏടുകള്‍ തുറന്നുവെക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 11,
      "arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",
      "malayalam": "ഉപരിലോകം മറ നീക്കികാണിക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 12,
      "arabic": "وَإِذَا ٱلۡجَحِيمُ سُعِرَتۡ",
      "malayalam": "ജ്വലിക്കുന്ന നരകാഗ്നി ആളിക്കത്തിക്കപ്പെടുമ്പോള്‍"
    },
    {
      "number": 13,
      "arabic": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",
      "malayalam": "സ്വര്‍ഗം അടുത്തു കൊണ്ടുവരപ്പെടുമ്പോള്‍"
    },
    {
      "number": 14,
      "arabic": "عَلِمَتۡ نَفۡسࣱ مَّا أَحۡضَرَتۡ",
      "malayalam": "ഓരോ വ്യക്തിയും താന്‍ തയ്യാറാക്കിക്കൊണ്ടു വന്നിട്ടുള്ളത് എന്തെന്ന് അറിയുന്നതാണ്‌"
    },
    {
      "number": 15,
      "arabic": "فَلَا أُقۡسِمُ بِٱلۡخُنَّسِ",
      "malayalam": "പിന്‍വാങ്ങിപ്പോകുന്നവയെ (നക്ഷത്രങ്ങളെ) ക്കൊണ്ട് ഞാന്‍ സത്യം ചെയ്തു പറയുന്നു"
    },
    {
      "number": 16,
      "arabic": "ٱلۡجَوَارِ ٱلۡكُنَّسِ",
      "malayalam": "സഞ്ചരിച്ചുകൊണ്ടിരിക്കുന്നവയും അപ്രത്യക്ഷമായിക്കൊണ്ടിരിക്കുന്നവയും"
    },
    {
      "number": 17,
      "arabic": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ",
      "malayalam": "രാത്രി നീങ്ങുമ്പോള്‍ അതു കൊണ്ടും"
    },
    {
      "number": 18,
      "arabic": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",
      "malayalam": "പ്രഭാതം വിടര്‍ന്ന് വരുമ്പോള്‍ അതു കൊണ്ടും (ഞാന്‍ സത്യം ചെയ്തു പറയുന്നു)"
    },
    {
      "number": 19,
      "arabic": "إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ‏",
      "malayalam": "തീര്‍ച്ചയായും ഇത് (ഖുര്‍ആന്‍) മാന്യനായ ഒരു ദൂതന്‍റെ വാക്കാകുന്നു"
    },
    {
      "number": 20,
      "arabic": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ‏",
      "malayalam": "ശക്തിയുള്ളവനും, സിംഹാസനസ്ഥനായ അല്ലാഹുവിങ്കല്‍ സ്ഥാനമുള്ളവനുമായ (ദൂതന്‍റെ)"
    },
    {
      "number": 21,
      "arabic": "مُّطَاعࣲ ثَمَّ أَمِينࣲ‏",
      "malayalam": "അവിടെ അനുസരിക്കപ്പെടുന്നവനും വിശ്വസ്തനുമായ (ദൂതന്‍റെ)"
    },
    {
      "number": 22,
      "arabic": "وَمَا صَاحِبُكُمُۥ بِمَجۡنُونࣲ‏",
      "malayalam": "നിങ്ങളുടെ കൂട്ടുകാരന്‍ (പ്രവാചകന്‍) ഒരു ഭ്രാന്തനല്ല തന്നെ"
    },
    {
      "number": 23,
      "arabic": "وَلَقَدۡ رَءَاهُۥ بِٱلۡأُفُقِ ٱلۡمُبِينِ",
      "malayalam": "തീര്‍ച്ചയായും അദ്ദേഹത്തെ (ജിബ്‌രീല്‍ എന്ന ദൂതനെ) പ്രത്യക്ഷമായ മണ്ഡലത്തില്‍ വെച്ച് അദ്ദേഹം കണ്ടിട്ടുണ്ട്‌"
    },
    {
      "number": 24,
      "arabic": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضظَنِينࣲ‏",
      "malayalam": "അദ്ദേഹം അദൃശ്യവാര്‍ത്തയുടെ കാര്യത്തില്‍ പിശുക്ക് കാണിക്കുന്നവനുമല്ല"
    },
    {
      "number": 25,
      "arabic": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ‏",
      "malayalam": "ഇത് (ഖുര്‍ആന്‍) ശപിക്കപ്പെട്ട ഒരു പിശാചിന്‍റെ വാക്കുമല്ല"
    },
    {
      "number": 26,
      "arabic": "فَأَيۡنَ تَذۡهَبُونَ",
      "malayalam": "അപ്പോള്‍ എങ്ങോട്ടാണ് നിങ്ങള്‍ പോകുന്നത്‌"
    },
    {
      "number": 27,
      "arabic": "إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ",
      "malayalam": "ഇത് ലോകര്‍ക്ക് വേണ്ടിയുള്ള ഒരു ഉല്‍ബോധനമല്ലാതെ മറ്റൊന്നുമല്ല"
    },
    {
      "number": 28,
      "arabic": "لِمَن شَآءَ مِنكُمُۥ أَن يَسۡتَقِيمَ",
      "malayalam": "അതായത് നിങ്ങളുടെ കൂട്ടത്തില്‍ നിന്ന് നേരെ നിലകൊള്ളാന്‍ ഉദ്ദേശിച്ചവര്‍ക്ക് വേണ്ടി"
    },
    {
      "number": 29,
      "arabic": "وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
      "malayalam": "ലോകരക്ഷിതാവായ അല്ലാഹു ഉദ്ദേശിക്കുന്നുവെങ്കിലല്ലാതെ നിങ്ങള്‍ ഉദ്ദേശിക്കുകയില്ല"
    }
  ]
}