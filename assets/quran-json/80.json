{
  "number": 80,
  "name": "سورَة عَبَسَ",
  "nameTrans": "Surah Abasa",
  "nameMl": "അബസ",
  "totalVerses": 42,
  "verses": [
    {
      "number": 1,
      "arabic": "عَبَسَ وَتَوَلَّىٰ",
      "malayalam": "അദ്ദേഹം മുഖം ചുളിച്ചു തിരിഞ്ഞുകളഞ്ഞു"
    },
    {
      "number": 2,
      "arabic": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ",
      "malayalam": "അദ്ദേഹത്തിന്‍റെ (നബിയുടെ) അടുത്ത് ആ അന്ധന്‍ വന്നതിനാല്‍"
    },
    {
      "number": 3,
      "arabic": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰ",
      "malayalam": "(നബിയേ,) നിനക്ക് എന്തറിയാം? അയാള്‍ (അന്ധന്‍) ഒരു വേള പരിശുദ്ധി പ്രാപിച്ചേക്കാമല്ലോ"
    },
    {
      "number": 4,
      "arabic": "أَوۡ يَذَّكَّرُ فَتَنفَعُهُ ٱلذِّكۡرَىٰ",
      "malayalam": "അല്ലെങ്കില്‍ ഉപദേശം സ്വീകരിക്കുകയും, ആ ഉപദേശം അയാള്‍ക്ക് പ്രയോജനപ്പെടുകയും ചെയ്തേക്കാമല്ലോ"
    },
    {
      "number": 5,
      "arabic": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ",
      "malayalam": "എന്നാല്‍ സ്വയം പര്യാപ്തത നടിച്ചവനാകട്ടെ"
    },
    {
      "number": 6,
      "arabic": "فَأَنتَ لَهُۥ تَصَّدَّىٰ",
      "malayalam": "നീ അവന്‍റെ നേരെ ശ്രദ്ധതിരിക്കുന്നു"
    },
    {
      "number": 7,
      "arabic": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ",
      "malayalam": "അവന്‍ പരിശുദ്ധി പ്രാപിക്കാതിരിക്കുന്നതിനാല്‍ നിനക്കെന്താണ് കുറ്റം"
    },
    {
      "number": 8,
      "arabic": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",
      "malayalam": "എന്നാല്‍ നിന്‍റെ അടുക്കല്‍ ഓടിവന്നവനാകട്ടെ"
    },
    {
      "number": 9,
      "arabic": "وَهُوَ يَخۡشَىٰ",
      "malayalam": "(അല്ലാഹുവെ) അവന്‍ ഭയപ്പെടുന്നവനായിക്കൊണ്ട്‌"
    },
    {
      "number": 10,
      "arabic": "فَأَنتَ عَنۡهُۥٓ تَّلَهَّىٰ",
      "malayalam": "അവന്‍റെ കാര്യത്തില്‍ നീ അശ്രദ്ധകാണിക്കുന്നു"
    },
    {
      "number": 11,
      "arabic": "كَلَّا إِنَّهَا تَذۡكِرَةࣱ‏",
      "malayalam": "നിസ്സംശയം ഇത് (ഖുര്‍ആന്‍) ഒരു ഉല്‍ബോധനമാകുന്നു; തീര്‍ച്ച"
    },
    {
      "number": 12,
      "arabic": "فَمَن شَآءَ ذَكَرَهُۥ",
      "malayalam": "അതിനാല്‍ ആര്‍ ഉദ്ദേശിക്കുന്നുവോ അവനത് ഓര്‍മിച്ച് കൊള്ളട്ടെ"
    },
    {
      "number": 13,
      "arabic": "فِي صُحُفࣲ مُّكَرَّمَةࣲ‏",
      "malayalam": "ആദരണീയമായ ചില ഏടുകളിലാണത്‌"
    },
    {
      "number": 14,
      "arabic": "مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ",
      "malayalam": "ഔന്നത്യം നല്‍കപ്പെട്ടതും പരിശുദ്ധമാക്കപ്പെട്ടതുമായ (ഏടുകളില്‍)"
    },
    {
      "number": 15,
      "arabic": "بِأَيۡدِي سَفَرَةࣲ‏",
      "malayalam": "ചില സന്ദേശവാഹകരുടെ കൈകളിലാണത്‌"
    },
    {
      "number": 16,
      "arabic": "كِرَامِۭ بَرَرَةࣲ‏",
      "malayalam": "മാന്യന്‍മാരും പുണ്യവാന്‍മാരും ആയിട്ടുള്ളവരുടെ"
    },
    {
      "number": 17,
      "arabic": "قُتِلَ ٱلۡإِنسَٰنُ مَا أَكۡفَرَهُۥ",
      "malayalam": "മനുഷ്യന്‍ നാശമടയട്ടെ. എന്താണവന്‍ ഇത്ര നന്ദികെട്ടവനാകാന്‍"
    },
    {
      "number": 18,
      "arabic": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ",
      "malayalam": "ഏതൊരു വസ്തുവില്‍ നിന്നാണ് അല്ലാഹു അവനെ സൃഷ്ടിച്ചത്‌"
    },
    {
      "number": 19,
      "arabic": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "malayalam": "ഒരു ബീജത്തില്‍ നിന്ന് അവനെ സൃഷ്ടിക്കുകയും, എന്നിട്ട് അവനെ (അവന്‍റെ കാര്യം) വ്യവസ്ഥപ്പെടുത്തുകയും ചെയ്തു"
    },
    {
      "number": 20,
      "arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "malayalam": "പിന്നീട് അവന്‍ മാര്‍ഗം എളുപ്പമാക്കുകയും ചെയ്തു"
    },
    {
      "number": 21,
      "arabic": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",
      "malayalam": "അനന്തരം അവനെ മരിപ്പിക്കുകയും, ഖബ്‌റില്‍ മറയ്ക്കുകയും ചെയ്തു"
    },
    {
      "number": 22,
      "arabic": "ثُمَّ إِذَا شَا أَنشَرَهُۥ",
      "malayalam": "പിന്നീട് അവന്‍ ഉദ്ദേശിക്കുമ്പോള്‍ അവനെ ഉയിര്‍ത്തെഴുന്നേല്‍പിക്കുന്നതാണ്‌"
    },
    {
      "number": 23,
      "arabic": "كَلَّا لَمَّا يَقۡضِ مَا أَمَرَهُۥ",
      "malayalam": "നിസ്സംശയം, അവനോട് അല്ലാഹു കല്‍പിച്ചത് അവന്‍ നിര്‍വഹിച്ചില്ല"
    },
    {
      "number": 24,
      "arabic": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦ",
      "malayalam": "എന്നാല്‍ മനുഷ്യന്‍ തന്‍റെ ഭക്ഷണത്തെപ്പറ്റി ഒന്നു ചിന്തിച്ച് നോക്കട്ടെ"
    },
    {
      "number": 25,
      "arabic": "إِنَّا صَبَبۡنَا ٱلۡمَآءَ صَبࣰّ ا",
      "malayalam": "നാം ശക്തിയായി മഴ വെള്ളം ചൊരിഞ്ഞുകൊടുത്തു"
    },
    {
      "number": 26,
      "arabic": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّ ا",
      "malayalam": "പിന്നീട് നാം ഭൂമിയെ ഒരു തരത്തില്‍ പിളര്‍ത്തി"
    },
    {
      "number": 27,
      "arabic": "فَأَنۢبَتۡنَا فِيهَا حَبࣰّ ا",
      "malayalam": "എന്നിട്ട് അതില്‍ നാം ധാന്യം മുളപ്പിച്ചു"
    },
    {
      "number": 28,
      "arabic": "وَعِنَبࣰ ا وَقَضۡبࣰ ا",
      "malayalam": "മുന്തിരിയും പച്ചക്കറികളും"
    },
    {
      "number": 29,
      "arabic": "وَزَيۡتُونࣰ ا وَنَخۡلࣰ ا",
      "malayalam": "ഒലീവും ഈന്തപ്പനയും"
    },
    {
      "number": 30,
      "arabic": "وَحَدَآئِقَ غُلۡبࣰ ا",
      "malayalam": "ഇടതൂര്‍ന്നു നില്‍ക്കുന്ന തോട്ടങ്ങളും"
    },
    {
      "number": 31,
      "arabic": "وَفَٰكِهَةࣰ وَأَبࣰّ ا",
      "malayalam": "പഴവര്‍ഗവും പുല്ലും"
    },
    {
      "number": 32,
      "arabic": "مَّتَٰعࣰ ا لَّكُمُۥ وَلِأَنۡعَٰمِكُمُۥ",
      "malayalam": "നിങ്ങള്‍ക്കും നിങ്ങളുടെ കന്നുകാലികള്‍ക്കും ഉപയോഗത്തിനായിട്ട്‌"
    },
    {
      "number": 33,
      "arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "malayalam": "എന്നാല്‍ ചെകിടടപ്പിക്കുന്ന ആ ശബ്ദം വന്നാല്‍"
    },
    {
      "number": 34,
      "arabic": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِۦ",
      "malayalam": "അതായത് മനുഷ്യന്‍ തന്‍റെ സഹോദരനെ വിട്ട് ഓടിപ്പോകുന്ന ദിവസം"
    },
    {
      "number": 35,
      "arabic": "وَأُمِّهِۦ وَأَبِيهِۦ",
      "malayalam": "തന്‍റെ മാതാവിനെയും പിതാവിനെയും"
    },
    {
      "number": 36,
      "arabic": "وَصَٰحِبَتِهِۦ وَبَنِيهِۦ",
      "malayalam": "ഭാര്യയെയും മക്കളെയും"
    },
    {
      "number": 37,
      "arabic": "لِكُلِّ ٱمۡرِيࣲٕ مِّنۡهُمُۥ يَوۡمَئِذࣲ شَأۡنࣱ يُغۡنِيهِۦ",
      "malayalam": "അവരില്‍പ്പെട്ട ഓരോ മനുഷ്യനും തനിക്ക് മതിയാവുന്നത്ര (ചിന്താ) വിഷയം അന്ന് ഉണ്ടായിരിക്കും"
    },
    {
      "number": 38,
      "arabic": "وُجُوهࣱ يَوۡمَئِذࣲ مُّسۡفِرَةࣱ‏",
      "malayalam": "അന്ന് ചില മുഖങ്ങള്‍ പ്രസന്നതയുള്ളവയായിരിക്കും"
    },
    {
      "number": 39,
      "arabic": "ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ‏",
      "malayalam": "ചിരിക്കുന്നവയും സന്തോഷം കൊള്ളുന്നവയും"
    },
    {
      "number": 40,
      "arabic": "وَوُجُوهࣱ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةࣱ‏",
      "malayalam": "വെറെ ചില മുഖങ്ങളാകട്ടെ അന്ന് പൊടി പുരണ്ടിരിക്കും"
    },
    {
      "number": 41,
      "arabic": "تَرۡهَقُهَا قَتَرَةٌ",
      "malayalam": "അവയെ കൂരിരുട്ട് മൂടിയിരിക്കും"
    },
    {
      "number": 42,
      "arabic": "أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",
      "malayalam": "അക്കൂട്ടരാകുന്നു അവിശ്വാസികളും അധര്‍മ്മകാരികളുമായിട്ടുള്ളവര്‍"
    }
  ]
}