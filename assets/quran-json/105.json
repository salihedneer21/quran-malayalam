{
  "number": 105,
  "name": "سورَة ٱلْفِيل",
  "nameTrans": "Surah Al-Fil",
  "nameMl": "അല്‍ ഫീല്‍",
  "totalVerses": 5,
  "verses": [
    {
      "number": 1,
      "arabic": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",
      "malayalam": "ആനക്കാരെക്കൊണ്ട് നിന്‍റെ രക്ഷിതാവ് പ്രവര്‍ത്തിച്ചത് എങ്ങനെ എന്ന് നീ കണ്ടില്ലേ"
    },
    {
      "number": 2,
      "arabic": "أَلَمۡ يَجۡعَلۡ كَيۡدَهُمُۥ فِي تَضۡلِيلࣲ‏",
      "malayalam": "അവരുടെ തന്ത്രം അവന്‍ പിഴവിലാക്കിയില്ലേ"
    },
    {
      "number": 3,
      "arabic": "وَأَرۡسَلَ عَلَيۡهِمُۥ طَيۡرًا أَبَابِيلَ",
      "malayalam": "കൂട്ടംകൂട്ടമായിക്കൊണ്ടുള്ള പക്ഷികളെ അവരുടെ നേര്‍ക്ക് അവന്‍ അയക്കുകയും ചെയ്തു"
    },
    {
      "number": 4,
      "arabic": "تَرۡمِيهِمُۥ بِحِجَارَةࣲ مِّن سِجِّيلࣲ‏",
      "malayalam": "ചുട്ടുപഴുപ്പിച്ച കളിമണ്‍കല്ലുകള്‍കൊണ്ട് അവരെ എറിയുന്നതായ"
    },
    {
      "number": 5,
      "arabic": "فَجَعَلَهُمُۥ كَعَصۡفࣲ مَّأۡكُولِۭ",
      "malayalam": "അങ്ങനെ അവന്‍ അവരെ തിന്നൊടുക്കപ്പെട്ട വൈക്കോല്‍ തുരുമ്പുപോലെയാക്കി"
    }
  ]
}