{
  "number": 109,
  "name": "سورَة ٱلْكَافِرُون",
  "nameTrans": "Surah Al-Kaafiroon",
  "nameMl": "അല്‍ കാഫിറൂന്‍",
  "totalVerses": 6,
  "verses": [
    {
      "number": 1,
      "arabic": "قُلۡ يَٰأَيُّهَا ٱلۡكَٰفِرُونَ",
      "malayalam": "(നബിയേ,) പറയുക: അവിശ്വാസികളേ"
    },
    {
      "number": 2,
      "arabic": "لَا أَعۡبُدُ مَا تَعۡبُدُونَ",
      "malayalam": "നിങ്ങള്‍ ആരാധിച്ചുവരുന്നതിനെ ഞാന്‍ ആരാധിക്കുന്നില്ല"
    },
    {
      "number": 3,
      "arabic": "وَلَا أَنتُمُۥ عَٰبِدُونَ مَا أَعۡبُدُ",
      "malayalam": "ഞാന്‍ ആരാധിച്ചുവരുന്നതിനെ നിങ്ങളും ആരാധിക്കുന്നവരല്ല"
    },
    {
      "number": 4,
      "arabic": "وَلَا أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمُۥ",
      "malayalam": "നിങ്ങള്‍ ആരാധിച്ചുവന്നതിനെ ഞാന്‍ ആരാധിക്കാന്‍ പോകുന്നവനുമല്ല"
    },
    {
      "number": 5,
      "arabic": "وَلَا أَنتُمُۥ عَٰبِدُونَ مَا أَعۡبُدُ",
      "malayalam": "ഞാന്‍ ആരാധിച്ചു വരുന്നതിനെ നിങ്ങളും ആരാധിക്കാന്‍ പോകുന്നവരല്ല"
    },
    {
      "number": 6,
      "arabic": "لَكُمُۥ دِينُكُمُۥ وَلِي دِينِ",
      "malayalam": "നിങ്ങള്‍ക്ക് നിങ്ങളുടെ മതം. എനിക്ക് എന്‍റെ മതവും"
    }
  ]
