  "nameTrans": "Surah Al-Qaari'ah",
  "nameMl": "അല്‍ ഖാരിഅ",
  "totalVerses": 11,
  "verses": [
    {
      "number": 1,
      "arabic": "ٱلۡقَارِعَةُ",
      "malayalam": "ഭയങ്കരമായ ആ സംഭവം"
    },
    {
      "number": 2,
      "arabic": "مَا ٱلۡقَارِعَةُ",
      "malayalam": "ഭയങ്കരമായ സംഭവം എന്നാല്‍ എന്താകുന്നു"
    },
    {
      "number": 3,
      "arabic": "وَمَا أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",
      "malayalam": "ഭയങ്കരമായ സംഭവമെന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ"
    },
    {
      "number": 4,
      "arabic": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",
      "malayalam": "മനുഷ്യന്‍മാര്‍ ചിന്നിച്ചിതറിയ പാറ്റയെപ്പോലെ ആകുന്ന ദിവസം"
    },
    {
      "number": 5,
      "arabic": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ",
      "malayalam": "പര്‍വ്വതങ്ങള്‍ കടഞ്ഞ ആട്ടിന്‍ രോമം പോലെയും"
    },
    {
      "number": 6,
      "arabic": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ",
      "malayalam": "അപ്പോള്‍ ഏതൊരാളുടെ തുലാസുകള്‍ ഘനം തൂങ്ങിയോ"
    },
    {
      "number": 7,
      "arabic": "فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏",
      "malayalam": "അവന്‍ സംതൃപ്തമായ ജീവിതത്തിലായിരിക്കും"
    },
    {
      "number": 8,
      "arabic": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",
      "malayalam": "എന്നാല്‍ ഏതൊരാളുടെ തുലാസുകള്‍ തൂക്കം കുറഞ്ഞതായോ"
    },
    {
      "number": 9,
      "arabic": "فَأُمُّهُۥ هَاوِيَةࣱ‏",
      "malayalam": "അവന്‍റെ സങ്കേതം ഹാവിയഃ ആയിരിക്കും"
    },
    {
      "number": 10,
      "arabic": "وَمَا أَدۡرَىٰكَ مَا هِيَهۡ",
      "malayalam": "ഹാവിയഃ എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ"
    },
    {
      "number": 11,
      "arabic": "نَارٌ حَامِيَةُۢ",
      "malayalam": "ചൂടേറിയ നരകാഗ്നിയത്രെ അത്‌"
    }
  ]
}