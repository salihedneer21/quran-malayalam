{
  "number": 86,
  "name": "سورَة ٱلطَّارِق",
  "nameTrans": "Surah At-Taariq",
  "nameMl": "അത്ത്വാരിഖ്",
  "totalVerses": 17,
  "verses": [
    {
      "number": 1,
      "arabic": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "malayalam": "ആകാശം തന്നെയാണ, രാത്രിയില്‍ വരുന്നതു തന്നെയാണ സത്യം"
    },
    {
      "number": 2,
      "arabic": "وَمَا أَدۡرَىٰكَ مَا ٱلطَّارِقُ",
      "malayalam": "രാത്രിയില്‍ വരുന്നത് എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയുമോ"
    },
    {
      "number": 3,
      "arabic": "ٱلنَّجۡمُ ٱلثَّاقِبُ",
      "malayalam": "തുളച്ച് കയറുന്ന നക്ഷത്രമത്രെ അത്‌"
    },
    {
      "number": 4,
      "arabic": "إِن كُلُّ نَفۡسࣲ لَّمَا عَلَيۡهَا حَافِظࣱ‏",
      "malayalam": "തന്‍റെ കാര്യത്തില്‍ ഒരു മേല്‍നോട്ടക്കാരനുണ്ടായിക്കൊണ്ടല്ലാതെ യാതൊരാളുമില്ല"
    },
    {
      "number": 5,
      "arabic": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ",
      "malayalam": "എന്നാല്‍ മനുഷ്യന്‍ ചിന്തിച്ചു നോക്കട്ടെ താന്‍ എന്തില്‍ നിന്നാണ് സൃഷ്ടിക്കപ്പെട്ടിരിക്കുന്നത് എന്ന്‌"
    },
    {
      "number": 6,
      "arabic": "خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏",
      "malayalam": "തെറിച്ചു വീഴുന്ന ഒരു ദ്രാവകത്തില്‍ നിന്നത്രെ അവന്‍ സൃഷ്ടിക്കപ്പെട്ടിരിക്കുന്നത്‌"
    },
    {
      "number": 7,
      "arabic": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ",
      "malayalam": "മുതുകെല്ലിനും, വാരിയെല്ലുകള്‍ക്കുമിടയില്‍ നിന്ന് അത് പുറത്തു വരുന്നു"
    },
    {
      "number": 8,
      "arabic": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ‏",
      "malayalam": "അവനെ (മനുഷ്യനെ) തിരിച്ചുകൊണ്ടു വരാന്‍ തീര്‍ച്ചയായും അവന്‍ (അല്ലാഹു) കഴിവുള്ളവനാകുന്നു"
    },
    {
      "number": 9,
      "arabic": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ",
      "malayalam": "രഹസ്യങ്ങള്‍ പരിശോധിക്കപ്പെടുന്ന ദിവസം"
    },
    {
      "number": 10,
      "arabic": "فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ‏",
      "malayalam": "അപ്പോള്‍ അവന് (മനുഷ്യന്‌) യാതൊരു ശക്തിയോ, സഹായിയോ ഉണ്ടായിരിക്കുകയില്ല"
    },
    {
      "number": 11,
      "arabic": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ",
      "malayalam": "ആവര്‍ത്തിച്ച് മഴപെയ്യിക്കുന്ന ആകാശത്തെക്കൊണ്ടും"
    },
    {
      "number": 12,
      "arabic": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",
      "malayalam": "സസ്യലതാദികള്‍ മുളപ്പിക്കുന്ന ഭൂമിയെക്കൊണ്ടും സത്യം"
    },
    {
      "number": 13,
      "arabic": "إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ‏",
      "malayalam": "തീര്‍ച്ചയായും ഇതു നിര്‍ണായകമായ ഒരു വാക്കാകുന്നു"
    },
    {
      "number": 14,
      "arabic": "وَمَا هُوَ بِٱلۡهَزۡلِ",
      "malayalam": "ഇതു തമാശയല്ല"
    },
    {
      "number": 15,
      "arabic": "إِنَّهُمُۥ يَكِيدُونَ كَيۡدࣰ ا",
      "malayalam": "തീര്‍ച്ചയായും അവര്‍ (വലിയ) തന്ത്രം പ്രയോഗിച്ചു കൊണ്ടിരിക്കും"
    },
    {
      "number": 16,
      "arabic": "وَأَكِيدُ كَيۡدࣰ ا",
      "malayalam": "ഞാനും (വലിയ) തന്ത്രം പ്രയോഗിച്ചു കൊണ്ടിരിക്കും"
    },
    {
      "number": 17,
      "arabic": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمُۥ رُوَيۡدَۢا",
      "malayalam": "ആകയാല്‍ (നബിയേ,) നീ സത്യനിഷേധികള്‍ക്ക് കാലതാമസം നല്‍കുക. അല്‍പസമയത്തേക്ക് അവര്‍ക്ക് താമസം നല്‍കിയേക്കുക"
    }
  ]
}