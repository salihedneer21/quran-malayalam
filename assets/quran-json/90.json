{
  "number": 90,
  "name": "سورَة ٱلْبَلَد",
  "nameTrans": "Surah Al-Balad",
  "nameMl": "അല്‍ ബലദ്",
  "totalVerses": 20,
  "verses": [
    {
      "number": 1,
      "arabic": "لَا أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ",
      "malayalam": "ഈ രാജ്യത്തെ (മക്കയെ) ക്കൊണ്ട് ഞാന്‍ സത്യം ചെയ്തു പറയുന്നു"
    },
    {
      "number": 2,
      "arabic": "وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ",
      "malayalam": "നീയാകട്ടെ ഈ രാജ്യത്തെ നിവാസിയാണ് താനും"
    },
    {
      "number": 3,
      "arabic": "وَوَالِدࣲ وَمَا وَلَدَ",
      "malayalam": "ജനയിതാവിനെയും, അവന്‍ ജനിപ്പിക്കുന്നതിനെയും തന്നെയാണ സത്യം"
    },
    {
      "number": 4,
      "arabic": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ",
      "malayalam": "തീര്‍ച്ചയായും മനുഷ്യനെ നാം സൃഷ്ടിച്ചിട്ടുള്ളത് ക്ലേശം സഹിക്കേണ്ട നിലയിലാകുന്നു"
    },
    {
      "number": 5,
      "arabic": "أَيَحۡسِبُ أَن لَّن يَقۡدِرَ عَلَيۡهِۦ أَحَدࣱ‏",
      "malayalam": "അവനെ പിടികൂടാന്‍ ആര്‍ക്കും സാധിക്കുകയേ ഇല്ലെന്ന് അവന്‍ വിചാരിക്കുന്നുണേ്ടാ"
    },
    {
      "number": 6,
      "arabic": "يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا",
      "malayalam": "അവന്‍ പറയുന്നു: ഞാന്‍ മേല്‍ക്കുമേല്‍ പണം തുലച്ചിരിക്കുന്നു എന്ന്‌"
    },
    {
      "number": 7,
      "arabic": "أَيَحۡسِبُ أَن لَّمۡ يَرَهُۥ أَحَدٌ",
      "malayalam": "അവന്‍ വിചാരിക്കുന്നുണേ്ടാ; അവനെ ആരുംകണ്ടിട്ടില്ലെന്ന്‌"
    },
    {
      "number": 8,
      "arabic": "أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ",
      "malayalam": "അവന് നാം രണ്ട് കണ്ണുകള്‍ ഉണ്ടാക്കി കൊടുത്തിട്ടില്ലേ"
    },
    {
      "number": 9,
      "arabic": "وَلِسَانࣰ ا وَشَفَتَيۡنِ",
      "malayalam": "ഒരു നാവും രണ്ടു ചുണ്ടുകളും"
    },
    {
      "number": 10,
      "arabic": "وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ",
      "malayalam": "തെളിഞ്ഞു നില്‍ക്കുന്ന രണ്ടു പാതകള്‍ അവന്നു നാം കാട്ടികൊടുക്കുകയും ചെയ്തിരിക്കുന്നു"
    },
    {
      "number": 11,
      "arabic": "فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ",
      "malayalam": "എന്നിട്ട് ആ മലമ്പാതയില്‍ അവന്‍ തള്ളിക്കടന്നില്ല"
    },
    {
      "number": 12,
      "arabic": "وَمَا أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ",
      "malayalam": "ആ മലമ്പാത എന്താണെന്ന് നിനക്കറിയാമോ"
    },
    {
      "number": 13,
      "arabic": "فَكَّ رَقَبَةً",
      "malayalam": "ഒരു അടിമയെ മോചിപ്പിക്കുക"
    },
    {
      "number": 14,
      "arabic": "أَوۡ أَطۡعَمَ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏",
      "malayalam": "അല്ലെങ്കില്‍ പട്ടിണിയുള്ള നാളില്‍ ഭക്ഷണം കൊടുക്കുക"
    },
    {
      "number": 15,
      "arabic": "يَتِيمࣰ ا ذَا مَقۡرَبَةٍ",
      "malayalam": "കുടുംബബന്ധമുള്ള അനാഥയ്ക്ക്‌"
    },
    {
      "number": 16,
      "arabic": "أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏",
      "malayalam": "അല്ലെങ്കില്‍ കടുത്ത ദാരിദ്യ്‌രമുള്ള സാധുവിന്‌"
    },
    {
      "number": 17,
      "arabic": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ",
      "malayalam": "പുറമെ, വിശ്വസിക്കുകയും, ക്ഷമ കൊണ്ടും കാരുണ്യം കൊണ്ടും പരസ്പരം ഉപദേശിക്കുകയും ചെയ്തവരുടെ കൂട്ടത്തില്‍ അവന്‍ ആയിത്തീരുകയും ചെയ്യുക"
    },
    {
      "number": 18,
      "arabic": "أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ",
      "malayalam": "അങ്ങനെ ചെയ്യുന്നവരത്രെ വലതുപക്ഷക്കാര്‍"
    },
    {
      "number": 19,
      "arabic": "وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمُۥ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ",
      "malayalam": "നമ്മുടെ ദൃഷ്ടാന്തങ്ങള്‍ നിഷേധിച്ചവരാരോ അവരത്രെ ഇടതുപക്ഷത്തിന്‍റെ ആള്‍ക്കാര്‍"
    },
    {
      "number": 20,
      "arabic": "عَلَيۡهِمُۥ نَارࣱ مُّوصَدَةُۢ",
      "malayalam": "അവരുടെ മേല്‍ അടച്ചുമൂടിയ നരകാഗ്നിയുണ്ട്‌"
    }
  ]
}