{
  "number": 94,
  "name": "سورَة ٱلشَّرْح",
  "nameTrans": "Surah Ash-Sharh",
  "nameMl": "അശ്ശര്‍ഹ്",
  "totalVerses": 8,
  "verses": [
    {
      "number": 1,
      "arabic": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ",
      "malayalam": "നിനക്ക് നിന്‍റെ ഹൃദയം നാം വിശാലതയുള്ളതാക്കി തന്നില്ലേ"
    },
    {
      "number": 2,
      "arabic": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ",
      "malayalam": "നിന്നില്‍ നിന്ന് നിന്‍റെ ആ ഭാരം നാം ഇറക്കിവെക്കുകയും ചെയ്തു"
    },
    {
      "number": 3,
      "arabic": "ٱلَّذِي أَنقَضَ ظَهۡرَكَ",
      "malayalam": "നിന്‍റെ മുതുകിനെ ഞെരിച്ചു കളഞ്ഞതായ (ഭാരം)"
    },
    {
      "number": 4,
      "arabic": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ",
      "malayalam": "നിനക്ക് നിന്‍റെ കീര്‍ത്തി നാം ഉയര്‍ത്തിത്തരികയും ചെയ്തിരിക്കുന്നു"
    },
    {
      "number": 5,
      "arabic": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا",
      "malayalam": "എന്നാല്‍ തീര്‍ച്ചയായും ഞെരുക്കത്തിന്‍റെ കൂടെ ഒരു എളുപ്പമുണ്ടായിരിക്കും"
    },
    {
      "number": 6,
      "arabic": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰ ا",
      "malayalam": "തീര്‍ച്ചയായും ഞെരുക്കത്തിന്‍റെ കൂടെ ഒരു എളുപ്പമുണ്ടായിരിക്കും"
    },
    {
      "number": 7,
      "arabic": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ",
      "malayalam": "ആകയാല്‍ നിനക്ക് ഒഴിവ് കിട്ടിയാല്‍ നീ അദ്ധ്വാനിക്കുക"
    },
    {
      "number": 8,
      "arabic": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب",
      "malayalam": "നിന്‍റെ രക്ഷിതാവിലേക്ക് തന്നെ നിന്‍റെ ആഗ്രഹം സമര്‍പ്പിക്കുകയും ചെയ്യുക"
    }
  ]
}