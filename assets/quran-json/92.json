{
  "number": 92,
  "name": "سورَة ٱللَّيْل",
  "nameTrans": "Surah Al-Layl",
  "nameMl": "അല്‍ലൈല്‍",
  "totalVerses": 21,
  "verses": [
    {
      "number": 1,
      "arabic": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",
      "malayalam": "രാവിനെതന്നെയാണ സത്യം ; അത് മൂടികൊണ്ടിരിക്കുമ്പോള്‍"
    },
    {
      "number": 2,
      "arabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "malayalam": "പകലിനെ തന്നെയാണ സത്യം ; അത് പ്രത്യക്ഷപ്പെടുമ്പോള്‍"
    },
    {
      "number": 3,
      "arabic": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰ",
      "malayalam": "ആണിനെയും പെണ്ണിനെയും സൃഷ്ടിച്ച രീതിയെ തന്നെയാണ സത്യം"
    },
    {
      "number": 4,
      "arabic": "إِنَّ سَعۡيَكُمُۥ لَشَتَّىٰ",
      "malayalam": "തീര്‍ച്ചയായും നിങ്ങളുടെ പരിശ്രമം വിഭിന്ന രൂപത്തിലുള്ളതാകുന്നു"
    },
    {
      "number": 5,
      "arabic": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
      "malayalam": "എന്നാല്‍ ഏതൊരാള്‍ ദാനം നല്‍കുകയും, സൂക്ഷ്മത പാലിക്കുകയും"
    },
    {
      "number": 6,
      "arabic": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
      "malayalam": "ഏറ്റവും ഉത്തമമായതിനെ സത്യപ്പെടുത്തുകയും ചെയ്തുവോ"
    },
    {
      "number": 7,
      "arabic": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",
      "malayalam": "അവന്നു നാം ഏറ്റവും എളുപ്പമായതിലേക്ക് സൌകര്യപ്പെടുത്തി കൊടുക്കുന്നതാണ്‌"
    },
    {
      "number": 8,
      "arabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
      "malayalam": "എന്നാല്‍ ആര്‍ പിശുക്കു കാണിക്കുകയും, സ്വയം പര്യാപ്തത നടിക്കുകയും"
    },
    {
      "number": 9,
      "arabic": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
      "malayalam": "ഏറ്റവും ഉത്തമമായതിനെ നിഷേധിച്ചു തള്ളുകയും ചെയ്തുവോ"
    },
    {
      "number": 10,
      "arabic": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",
      "malayalam": "അവന്നു നാം ഏറ്റവും ഞെരുക്കമുള്ളതിലേക്ക് സൌകര്യമൊരുക്കികൊടുക്കുന്നതാണ്‌"
    },
    {
      "number": 11,
      "arabic": "وَمَا يُغۡنِي عَنۡهُۥ مَالُهُۥ إِذَا تَرَدَّىٰ",
      "malayalam": "അവന്‍ നാശത്തില്‍ പതിക്കുമ്പോള്‍ അവന്‍റെ ധനം അവന്ന് പ്രയോജനപ്പെടുന്നതല്ല"
    },
    {
      "number": 12,
      "arabic": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ",
      "malayalam": "തീര്‍ച്ചയായും മാര്‍ഗദര്‍ശനം നമ്മുടെ ബാധ്യതയാകുന്നു"
    },
    {
      "number": 13,
      "arabic": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",
      "malayalam": "തീര്‍ച്ചയായും നമുക്കുള്ളതാകുന്നു പരലോകവും ഇഹലോകവും"
    },
    {
      "number": 14,
      "arabic": "فَأَنذَرۡتُكُمُۥ نَارࣰ ا تَّلَظَّىٰ",
      "malayalam": "അതിനാല്‍ ആളിക്കത്തിക്കൊണ്ടിരിക്കുന്ന അഗ്നിയെപ്പറ്റി ഞാന്‍ നിങ്ങള്‍ക്ക് താക്കീത് നല്‍കിയിരിക്കുന്നു"
    },
    {
      "number": 15,
      "arabic": "لَا يَصۡلَىٰهَا إِلَّا ٱلۡأَشۡقَى",
      "malayalam": "ഏറ്റവും ദുഷ്ടനായ വ്യക്തിയല്ലാതെ അതില്‍ പ്രവേശിക്കുകയില്ല"
    },
    {
      "number": 16,
      "arabic": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",
      "malayalam": "നിഷേധിച്ചു തള്ളുകയും, പിന്തിരിഞ്ഞു കളയുകയും (വ്യക്തി)"
    },
    {
      "number": 17,
      "arabic": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى",
      "malayalam": "ഏറ്റവും സൂക്ഷ്മതയുള്ള വ്യക്തി അതില്‍ നിന്ന് അകറ്റി നിര്‍ത്തപ്പെടുന്നതാണ്‌"
    },
    {
      "number": 18,
      "arabic": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",
      "malayalam": "പരിശുദ്ധിനേടുവാനായി തന്‍റെ ധനം നല്‍കുന്ന (വ്യക്തി)"
    },
    {
      "number": 19,
      "arabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰ",
      "malayalam": "പ്രത്യുപകാരം നല്‍കപ്പെടേണ്ടതായ യാതൊരു അനുഗ്രഹവും അവന്‍റെ പക്കല്‍ ഒരാള്‍ക്കുമില്ല"
    },
    {
      "number": 20,
      "arabic": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
      "malayalam": "തന്‍റെ അത്യുന്നതനായ രക്ഷിതാവിന്‍റെ പ്രീതി തേടുക എന്നതല്ലാതെ"
    },
    {
      "number": 21,
      "arabic": "وَلَسَوۡفَ يَرۡضَىٰ",
      "malayalam": "വഴിയെ അവന്‍ തൃപ്തിപ്പെടുന്നതാണ്‌"
    }
  ]
}