{
  "number": 111,
  "name": "سورَة ٱلْمَسَد",
  "nameTrans": "Surah Al-Masad",
  "nameMl": "അല്‍ മസദ്",
  "totalVerses": 5,
  "verses": [
    {
      "number": 1,
      "arabic": "تَبَّتۡ يَدَا أَبِي لَهۡبࣲ وَتَبَّ",
      "malayalam": "അബൂലഹബിന്‍റെ ഇരുകൈകളും നശിച്ചിരിക്കുന്നു. അവന്‍ നാശമടയുകയും ചെയ്തിരിക്കുന്നു"
    },
    {
      "number": 2,
      "arabic": "مَا أَغۡنَىٰ عَنۡهُۥ مَالُهُۥ وَمَا كَسَبَ",
      "malayalam": "അവന്‍റെ ധനമോ അവന്‍ സമ്പാദിച്ചുവെച്ചതോ അവനു ഉപകാരപ്പെട്ടില്ല"
    },
    {
      "number": 3,
      "arabic": "سَيَصۡلَىٰ نَارࣰ ا ذَاتَ لَهَبࣲ‏",
      "malayalam": "തീജ്വാലകളുള്ള നരകാഗ്നിയില്‍ അവന്‍ പ്രവേശിക്കുന്നതാണ്‌"
    },
    {
      "number": 4,
      "arabic": "وَٱمۡرَأَتُهُۥ حَمَّالَةُ ٱلۡحَطَبِ",
      "malayalam": "വിറകുചുമട്ടുകാരിയായ അവന്‍റെ ഭാര്യയും"
    },
    {
      "number": 5,
      "arabic": "فِي جِيدِهَا حَبۡلࣱ مِّن مَّسَدِۭ",
      "malayalam": "അവളുടെ കഴുത്തില്‍ ഈന്തപ്പനനാരുകൊണ്ടുള്ള ഒരു കയറുണ്ടായിരിക്കും"
    }
  ]
}