{
  "number": 96,
  "name": "سورَة ٱلْعَلَق",
  "nameTrans": "Surah Al-Alaq",
  "nameMl": "അല്‍ അലഖ്",
  "totalVerses": 19,
  "verses": [
    {
      "number": 1,
      "arabic": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ",
      "malayalam": "സൃഷ്ടിച്ചവനായ നിന്‍റെ രക്ഷിതാവിന്‍റെ നാമത്തില്‍ വായിക്കുക"
    },
    {
      "number": 2,
      "arabic": "خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ",
      "malayalam": "മനുഷ്യനെ അവന്‍ ഭ്രൂണത്തില്‍ നിന്ന് സൃഷ്ടിച്ചിരിക്കുന്നു"
    },
    {
      "number": 3,
      "arabic": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ",
      "malayalam": "നീ വായിക്കുക നിന്‍റെ രക്ഷിതാവ് ഏറ്റവും വലിയ ഔദാര്യവാനാകുന്നു"
    },
    {
      "number": 4,
      "arabic": "ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ",
      "malayalam": "പേന കൊണ്ട് പഠിപ്പിച്ചവന്‍"
    },
    {
      "number": 5,
      "arabic": "عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ",
      "malayalam": "മനുഷ്യന് അറിയാത്തത് അവന്‍ പഠിപ്പിച്ചിരിക്കുന്നു"
    },
    {
      "number": 6,
      "arabic": "كَلَّا إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰ",
      "malayalam": "നിസ്സംശയം മനുഷ്യന്‍ ധിക്കാരിയായി തീരുന്നു"
    },
    {
      "number": 7,
      "arabic": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰ",
      "malayalam": "തന്നെ സ്വയം പര്യാപ്തനായി കണ്ടതിനാല്‍"
    },
    {
      "number": 8,
      "arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰ",
      "malayalam": "തീര്‍ച്ചയായും നിന്‍റെ രക്ഷിതാവിലേക്കാണ് മടക്കം"
    },
    {
      "number": 9,
      "arabic": "أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ",
      "malayalam": "വിലക്കുന്നവനെ നീ കണ്ടുവോ"
    },
    {
      "number": 10,
      "arabic": "عَبۡدًا إِذَا صَلَّىٰ",
      "malayalam": "ഒരു അടിയനെ, അവന്‍ നമസ്കരിച്ചാല്‍"
    },
    {
      "number": 11,
      "arabic": "أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰ",
      "malayalam": "അദ്ദേഹം സന്‍മാര്‍ഗത്തിലാണെങ്കില്‍ , (ആ വിലക്കുന്നവന്‍റെ അവസ്ഥ എന്തായിരിക്കുമെന്ന്‌) നീ കണ്ടുവോ"
    },
    {
      "number": 12,
      "arabic": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰ",
      "malayalam": "അഥവാ അദ്ദേഹം സൂക്ഷ്മത കൈ കൊള്ളാന്‍ കല്‍പിച്ചിരിക്കുകയാണെങ്കില്‍"
    },
    {
      "number": 13,
      "arabic": "أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰ",
      "malayalam": "അവന്‍ (ആ വിലക്കുന്നവന്‍) നിഷേധിച്ചു തള്ളുകയും തിരിഞ്ഞുകളയുകയും ചെയ്തിരിക്കയാണെങ്കില്‍ (അവന്‍റെ അവസ്ഥ എന്തായിരിക്കുമെന്ന്‌) നീ കണ്ടുവോ"
    },
    {
      "number": 14,
      "arabic": "أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "malayalam": "അവന്‍ മനസ്സിലാക്കിയിട്ടില്ലേ, അല്ലാഹു കാണുന്നുണെ്ടന്ന്‌"
    },
    {
      "number": 15,
      "arabic": "كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ",
      "malayalam": "നിസ്സംശയം. അവന്‍ വിരമിച്ചിട്ടില്ലെങ്കല്‍ നാം ആ കുടുമ പിടിച്ചു വലിക്കുക തന്നെ ചെയ്യും"
    },
    {
      "number": 16,
      "arabic": "نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏",
      "malayalam": "കള്ളം പറയുന്ന , പാപം ചെയ്യുന്ന കുടുമ"
    },
    {
      "number": 17,
      "arabic": "فَلۡيَدۡعُ نَادِيَهُۥ",
      "malayalam": "എന്നിട്ട് അവന്‍ അവന്‍റെ സഭയിലുള്ളവരെ വിളിച്ചുകൊള്ളട്ടെ"
    },
    {
      "number": 18,
      "arabic": "سَنَدۡعُ ٱلزَّبَانِيَةَ",
      "malayalam": "നാം സബാനിയത്തിനെ (ശിക്ഷ നടപ്പാക്കുന്ന മലക്കുകളെ) വിളിച്ചുകൊള്ളാം"
    },
    {
      "number": 19,
      "arabic": "كَلَّا لَا تُطِعۡهُۥ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩",
      "malayalam": "നിസ്സംശയം; നീ അവനെ അനുസരിച്ചു പോകരുത് , നീ പ്രണമിക്കുകയും സാമീപ്യം നേടുകയും ചെയ്യുക"
    }
  ]
}