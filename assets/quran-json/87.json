{
  "number": 87,
  "name": "سورَة ٱلْأَعْلَىٰ",
  "nameTrans": "Surah Al-A'la",
  "nameMl": "അല്‍ അഅ് ലാ",
  "totalVerses": 19,
  "verses": [
    {
      "number": 1,
      "arabic": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
      "malayalam": "അത്യുന്നതനായ നിന്‍റെ രക്ഷിതാവിന്‍റെ നാമം പ്രകീര്‍ത്തിക്കുക"
    },
    {
      "number": 2,
      "arabic": "ٱلَّذِي خَلَقَ فَسَوَّىٰ",
      "malayalam": "സൃഷ്ടിക്കുകയും, സംവിധാനിക്കുകയും ചെയ്ത (രക്ഷിതാവിന്‍റെ)"
    },
    {
      "number": 3,
      "arabic": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ",
      "malayalam": "വ്യവസ്ഥ നിര്‍ണയിച്ചു മാര്‍ഗദര്‍ശനം നല്‍കിയവനും"
    },
    {
      "number": 4,
      "arabic": "وَٱلَّذِي أَخۡرَجَ ٱلۡمَرۡعَىٰ",
      "malayalam": "മേച്ചില്‍ പുറങ്ങള്‍ ഉല്‍പാദിപ്പിച്ചവനും"
    },
    {
      "number": 5,
      "arabic": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",
      "malayalam": "എന്നിട്ട് അതിനെ ഉണങ്ങിക്കരിഞ്ഞ ചവറാക്കി തീര്‍ത്തവനുമായ (രക്ഷിതാവിന്‍റെ നാമം)"
    },
    {
      "number": 6,
      "arabic": "سَنُقۡرِئُكَ فَلَا تَنسَىٰ",
      "malayalam": "നിനക്ക് നാം ഓതിത്തരാം. നീ മറന്നുപോകുകയില്ല"
    },
    {
      "number": 7,
      "arabic": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",
      "malayalam": "അല്ലാഹു ഉദ്ദേശിച്ചതൊഴികെ. തീര്‍ച്ചയായും അവന്‍ പരസ്യമായതും, രഹസ്യമായിരിക്കുന്നതും അറിയുന്നു"
    },
    {
      "number": 8,
      "arabic": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",
      "malayalam": "കൂടുതല്‍ എളുപ്പമുള്ളതിലേക്ക് നിനക്ക് നാം സൌകര്യമുണ്ടാക്കിത്തരുന്നതുമാണ്‌"
    },
    {
      "number": 9,
      "arabic": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
      "malayalam": "അതിനാല്‍ ഉപദേശം ഫലപ്പെടുന്നുവെങ്കില്‍ നീ ഉപദേശിച്ചു കൊള്ളുക"
    },
    {
      "number": 10,
      "arabic": "سَيَذَّكَّرُ مَن يَخۡشَىٰ",
      "malayalam": "ഭയപ്പെടുന്നവര്‍ ഉപദേശം സ്വീകരിച്ചു കൊള്ളുന്നതാണ്‌"
    },
    {
      "number": 11,
      "arabic": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",
      "malayalam": "ഏറ്റവും നിര്‍ഭാഗ്യവാനായിട്ടുള്ളവന്‍ അതിനെ (ഉപദേശത്തെ) വിട്ടകന്നു പോകുന്നതാണ്‌"
    },
    {
      "number": 12,
      "arabic": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
      "malayalam": "വലിയ അഗ്നിയില്‍ കടന്ന് എരിയുന്നവനത്രെ അവന്‍"
    },
    {
      "number": 13,
      "arabic": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
      "malayalam": "പിന്നീട് അവന്‍ അതില്‍ മരിക്കുകയില്ല. ജീവിക്കുകയുമില്ല"
    },
    {
      "number": 14,
      "arabic": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
      "malayalam": "തീര്‍ച്ചയായും പരിശുദ്ധി നേടിയവര്‍ വിജയം പ്രാപിച്ചു"
    },
    {
      "number": 15,
      "arabic": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
      "malayalam": "തന്‍റെ രക്ഷിതാവിന്‍റെ നാമം സ്മരിക്കുകയും എന്നിട്ട് നമസ്കരിക്കുകയും (ചെയ്തവന്‍)"
    },
    {
      "number": 16,
      "arabic": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
      "malayalam": "പക്ഷെ, നിങ്ങള്‍ ഐഹികജീവിതത്തിന്ന് കൂടുതല്‍ പ്രാധാന്യം നല്‍കുന്നു"
    },
    {
      "number": 17,
      "arabic": "وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰ",
      "malayalam": "പരലോകമാകുന്നു ഏറ്റവും ഉത്തമവും നിലനില്‍ക്കുന്നതും"
    },
    {
      "number": 18,
      "arabic": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ",
      "malayalam": "തീര്‍ച്ചയായും ഇത് ആദ്യത്തെ ഏടുകളില്‍ തന്നെയുണ്ട്‌"
    },
    {
      "number": 19,
      "arabic": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ",
      "malayalam": "അതായത് ഇബ്രാഹീമിന്‍റെയും മൂസായുടെയും ഏടുകളില്‍"
    }
  ]
}