  "nameTrans": "Surah Al-Humazah",
  "nameMl": "അല്‍ ഹുമസഃ",
  "totalVerses": 9,
  "verses": [
    {
      "number": 1,
      "arabic": "وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ",
      "malayalam": "കുത്തുവാക്ക് പറയുന്നവനും അവഹേളിക്കുന്നവനുമായ ഏതൊരാള്‍ക്കും നാശം"
    },
    {
      "number": 2,
      "arabic": "ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ",
      "malayalam": "അതായത് ധനം ശേഖരിക്കുകയും അത് എണ്ണിനോക്കിക്കൊണ്ടിരിക്കുകയും ചെയ്യുന്നവന്‌"
    },
    {
      "number": 3,
      "arabic": "يَحۡسِبُ أَنَّ مَالَهُۥ أَخۡلَدَهُۥ",
      "malayalam": "അവന്‍റെ ധനം അവന് ശാശ്വത ജീവിതം നല്‍കിയിരിക്കുന്നു എന്ന് അവന്‍ വിചാരിക്കുന്നു"
    },
    {
      "number": 4,
      "arabic": "كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",
      "malayalam": "നിസ്സംശയം, അവന്‍ ഹുത്വമയില്‍ എറിയപ്പെടുക തന്നെ ചെയ്യും"
    },
    {
      "number": 5,
      "arabic": "وَمَا أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",
      "malayalam": "ഹുത്വമ എന്നാല്‍ എന്താണെന്ന് നിനക്കറിയാമോ"
    },
    {
      "number": 6,
      "arabic": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",
      "malayalam": "അത് അല്ലാഹുവിന്‍റെ ജ്വലിപ്പിക്കപ്പെട്ട അഗ്നിയാകുന്നു"
    },
    {
      "number": 7,
      "arabic": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ",
      "malayalam": "ഹൃദയങ്ങളിലേക്ക് കത്തിപ്പടരുന്നതായ"
    },
    {
      "number": 8,
      "arabic": "إِنَّهَا عَلَيۡهِمُۥ مُوصَدَةࣱ‏",
      "malayalam": "തീര്‍ച്ചയായും അത് അവരുടെ മേല്‍ അടച്ചുമൂടപ്പെടുന്നതായിരിക്കും"
    },
    {
      "number": 9,
      "arabic": "فِي عَمَدࣲ مُّمَدَّدَةِۭ",
      "malayalam": "നീട്ടിയുണ്ടാക്കപ്പെട്ട സ്തംഭങ്ങളിലായിക്കൊണ്ട്‌"
    }
  ]
}