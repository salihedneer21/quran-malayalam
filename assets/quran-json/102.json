{
  "number": 102,
  "name": "سورَة ٱلتَّكَاثُر",
  "nameTrans": "Surah At-Takathur",
  "nameMl": "അത്തകാഥുര്‍",
  "totalVerses": 8,
  "verses": [
    {
      "number": 1,
      "arabic": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
      "malayalam": "പരസ്പരം പെരുമനടിക്കുക എന്ന കാര്യം നിങ്ങളെ അശ്രദ്ധയിലാക്കിയിരിക്കുന്നു"
    },
    {
      "number": 2,
      "arabic": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
      "malayalam": "നിങ്ങള്‍ ശവകുടീരങ്ങള്‍ സന്ദര്‍ശിക്കുന്നത് വരേക്കും"
    },
    {
      "number": 3,
      "arabic": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "malayalam": "നിസ്സംശയം, നിങ്ങള്‍ വഴിയെ അറിഞ്ഞ് കൊള്ളും"
    },
    {
      "number": 4,
      "arabic": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "malayalam": "പിന്നെയും നിസ്സംശയം നിങ്ങള്‍ വഴിയെ അറിഞ്ഞ് കൊള്ളും"
    },
    {
      "number": 5,
      "arabic": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",
      "malayalam": "നിസ്സംശയം, നിങ്ങള്‍ ദൃഢമായ അറിവ് അറിയുമായിരുന്നെങ്കില്‍"
    },
    {
      "number": 6,
      "arabic": "لَتَرَوُنَّ ٱلۡجَحِيمَ",
      "malayalam": "ജ്വലിക്കുന്ന നരകത്തെ നിങ്ങള്‍ കാണുക തന്നെ ചെയ്യും"
    },
    {
      "number": 7,
      "arabic": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",
      "malayalam": "പിന്നെ തീര്‍ച്ചയായും നിങ്ങള്‍ അതിനെ ദൃഢമായും കണ്ണാല്‍ കാണുക തന്നെ ചെയ്യും"
    },
    {
      "number": 8,
      "arabic": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "malayalam": "പിന്നീട് ആ ദിവസത്തില്‍ സുഖാനുഭവങ്ങളെ പറ്റി തീര്‍ച്ചയായും നിങ്ങള്‍ ചോദ്യം ചെയ്യപ്പെടുകതന്നെ ചെയ്യും"
    }
  ]
}